{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*\\.(?:js|css|png|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|otf|eot|ico|xml|txt|pdf|zip|rar|json|webmanifest))$", "continue": true },
    { "source": "/[^.]+", "destination": "/api/ssrOG" },
    { "source": "/", "destination": "/api/ssrOG" }
  ]
}